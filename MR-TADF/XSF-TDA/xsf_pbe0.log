from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import os
import glob
import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from SF_XTDA import SA_SF_TDA
os.environ['OMP_NUM_THREADS'] = '12'
os.environ['MKL_NUM_THREADS'] = '12'
os.environ['MKL_DYNAMIC'] = 'FALSE'
os.environ['KMP_AFFINITY'] = 'granularity=fine,compact,1,0'
os.environ['OPENBLAS_NUM_THREADS'] = '12'
lib.num_threads(48)

#angles = np.arange(0,181,5)
nstates = 7
#funs = ['blyp','pbe','b3lyp','pbe0','bhandhlyp','lc_blyp','cam_b3lyp']
funs = ['pbe0']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    #filename =
    with open(name, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

path = '/export/home/lizd20/zhaohw/tddft/tadf/mewes_35/geometries/'
files = [str(i).zfill(2) for i in range(1, 36)]
mols = [i+'/geom.xyz' for i in files]
#mols = ['17_optimized.xyz']
for fun in funs:
    for i,mol_i in enumerate(mols[24:]):
        atoms = read_xyz(path+mol_i)    
        #if len(atoms)>70 or len(atoms)<50:
        #    continue
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.1
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #if i == 0:
        data = scf.chkfile.load(f'/export/home/lizd20/zhaohw/tddft/tadf/mewes_35/xsf/svp/chk_file/mol{i+25}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        #else:
        #mf.chkfile = f'chk_file/mol{i+14}.chk'
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #if i == 0:
        #    stable = True
        #else:
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')
        sf_tda = None
        sf_tda = SA_SF_TDA(mf,SA=3)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        print(f'ALDA0_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        _ = sf_tda.analyse()
        end_alda0 = time.time()
        print(f'Time use {(end_alda0-end_scf)/3600:6.2f} hours')
        sf_tda.calculate_TDM()
        #tda_time = time.time()
        #print(f'Time use for TDM calculation {(tda_time-end_scf)/3600:6.2f} hours')

        sf_tda = None        
        sf_tda = SA_SF_TDA(mf,SA=3,method=1,collinear_samples=30)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        print(f'Multicollinear_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        _ = sf_tda.analyse()
        end_multi = time.time()
        print(f'Time use {(end_multi-end_alda0)/3600:6.2f} hours')
        #sf_tda.calculate_TDM()
        #tda_time = time.time()
        #print(f'Time use for TDM calculation {(tda_time-end_multi)/3600:6.2f} hours')


print('Done')
