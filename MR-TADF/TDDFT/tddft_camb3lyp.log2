from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import os
import glob
import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from XSF_TDA import XSF_TDA
lib.num_threads(48)

#angles = np.arange(0,181,5)
nstates = 5
#funs = ['blyp','pbe','b3lyp','pbe0','bhandhlyp','lc_blyp','cam_b3lyp']
funs = ['cam-b3lyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    #filename =
    with open(name, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

path = '/export/home/lizd20/zhaohw/tddft/tadf/mewes_35/geometries/'
files = [str(i).zfill(2) for i in range(1, 36)]
mols = [i+'/geom.xyz' for i in files]
for fun in funs:
    for i,mol_i in enumerate(mols[25:]):
        atoms = read_xyz(path+mol_i)
        #if len(atoms) > 70 or len(atoms) < 50:
        #    continue    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.4
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.init_guess = 'huckel'
        #if fun == 'b3lyp':
        #    mf.chkfile = f'chk_file/mol{i+1}.chk'
        #else:
        data = scf.chkfile.load(f'/export/home/lizd20/zhaohw/tddft/tadf/mewes_35/tda/chk_file/mol{i+26}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')

        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        mytd.kernel()
        print(mol_i,f' {fun} Singlet')
        mytd.analyze()

        mytd2 = tddft.TDDFT(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        print(mol_i,f' {fun} Triplet')
        mytd2.analyze()
        end_td = time.time()
        print(f'Time use {(end_td-end_scf)/3600:6.2f} hours') 

print('Done')
