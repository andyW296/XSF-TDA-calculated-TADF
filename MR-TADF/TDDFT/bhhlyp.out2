from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py

import sys
sys.path.append('/home/lx/usrs/zhw/software/XTDDFT')
from xtddft.XSF_TDA import XSF_TDA
#from xtddft.SF_TDA import SF_TDA
#from xtddft.XTDA import XTDA
#from x2c_hamiltonian import sfX2C_soDKH1_1c
#from x2c_hamiltonian.driver.si_driver_2 import SI_driver
#from x2c_hamiltonian.driver.tdm import TDM_S1,TDM_S_1,TDM_S

#c = lib.param.LIGHT_SPEED
#ha2eV = 27.2113834

#angles = np.arange(0,181,5)
nstates = 5
bas = 'def2-svp'
def read_xyz(name):
   with open(name, 'r') as f:
       lines = f.readlines()
       atoms = []
       for line in lines[2:]:
          parts = line.split()
          if len(parts) >=4:
             atom = parts[0]
             coords = list(map(float, parts[1:4]))
             atoms.append((atom,coords))
   return atoms

count = 0
path = '/home/lx/usrs/zhw/tddft/tadf/mewes_35/geometries/'
#funs = ['svwn','blyp','pbe','b3lyp','pbe0','bhandhlyp','hf']
#funs = ['blyp','b3lyp','pbe0','bhandhlyp','camb3lyp']
#mols = ['01/geom.xyz','26/geom.xyz','32/geom.xyz','33/geom.xyz']
mols = [str(i).zfill(2) for i in range(1, 36)]
funs = ['bhandhlyp']
for fun in funs:
    for ind,mol_i in enumerate(mols):
        mol = gto.M(                 
          atom = path+mol_i+'/geom.xyz',
          basis = bas,
          charge = 0,
          spin = 0, 
          verbose = 4,
          #symmetry=True,
        )    

        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf = scf.sfx2c(mf)
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.chkfile = f'chkfile/mol{ind+1}.chk'
        data = scf.chkfile.load(f'chkfile/mol{ind+1}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        stable = True
        #mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
#        print('TDA for singlet and triplet excited energy')
#        mytd = tddft.TDA(mf)
#        mytd.nstates = nstates
#        mytd.singlet = True
#        tda_e,tda_v = mytd.kernel()
#        mytd.analyze()
        
#        mytd = tddft.TDA(mf)
#        mytd.nstates = nstates
#        mytd.singlet = False 
#        tda_e2,tda_v2 = mytd.kernel()
#        mytd.analyze()

        print('TD-DFT for Triplet excited energy')
#        mytd = tddft.TDDFT(mf)
#        mytd.nstates = nstates
#        mytd.singlet = True
#        tda_e,tda_v = mytd.kernel()
#        mytd.analyze()

        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        mytd.singlet = False
        tda_e2,tda_v2 = mytd.kernel()
        mytd.analyze()


print('Done')
