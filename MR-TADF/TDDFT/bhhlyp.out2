bas = 'def2-svp'
def read_xyz(name):
   with open(name, 'r') as f:
       lines = f.readlines()
       atoms = []
       for line in lines[2:]:
          parts = line.split()
          if len(parts) >=4:
             atom = parts[0]
             coords = list(map(float, parts[1:4]))
             atoms.append((atom,coords))
   return atoms

