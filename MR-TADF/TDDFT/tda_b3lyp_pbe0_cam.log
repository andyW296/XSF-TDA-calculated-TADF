        #    continue    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.4
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.init_guess = 'huckel'
        if fun == 'b3lyp':
            mf.chkfile = f'chk_file/mol{i+1}.chk'
        else:
            data = scf.chkfile.load(f'chk_file/mol{i+1}.chk','scf')
            mf.mo_coeff = data['mo_coeff']
            mf.mo_occ = data['mo_occ']
            mf.mo_energy = data['mo_energy']
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')

        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        print(mol_i,' {fun} Singlet')
        mytd.analyze()

        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        print(mol_i,' {fun} Triplet')
        mytd2.analyze()

print('Done')
