import os
os.environ['OMP_NUM_THREADS'] = '32'
os.environ['MKL_NUM_THREADS'] = '32'
os.environ['OPENBLAS_NUM_THREADS'] = '32'
os.environ['NUMEXPR_NUM_THREADS'] = '32'
from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci,sftda
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import glob
import sys
sys.path.append('/data/zhw/software/XTDDFT/')
from xtddft.XSF_TDA import XSF_TDA
lib.num_threads(32)
#angles = np.arange(0,181,5)
nstates = 7
#funs = ['blyp','pbe','b3lyp','pbe0','bhandhlyp','lc_blyp','cam_b3lyp']
funs = ['bhandhlyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    #filename =
    with open(name, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

path = '/data/zhw/tadf/mewes_35/geometries/'
files = [str(i).zfill(2) for i in range(1, 36)]
mols = [i+'/geom.xyz' for i in files]
#mols = ['17_optimized.xyz']
for fun in funs:
    for ind,mol_i in enumerate(mols[10:]):
        atoms = read_xyz(path+mol_i)    
        #if len(atoms)>70 or len(atoms)<50:
        #    continue
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.4
        #mf.max_cycle = 100
        #mf.diis_damp = 0.5
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #if i == 0:
        #data = scf.chkfile.load(f'../chk_file/mol{i+1}.chk','scf')
        #mf.mo_coeff = data['mo_coeff']
        #mf.mo_occ = data['mo_occ']
        #mf.mo_energy = data['mo_energy']
        #else:
        #mf.init_guess = 'huckel'
        mf.chkfile = f'chkfile/mol{ind+11}.chk'
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #if i == 0:
        #    stable = True
        #else:
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.max_cycle=150
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')
        sf_tda = None
        sf_tda = XSF_TDA(mf,method=1)
        e0, values = sf_tda.kernel(nstates=nstates)
        print(f'ALDA0_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        _ = sf_tda.analyse()
        end_alda0 = time.time()
        print(f'Time use {(end_alda0-end_scf)/3600:6.2f} hours')
        #sf_tda.calculate_TDM()
        #tda_time = time.time()
        #print(f'Time use for TDM calculation {(tda_time-end_scf)/3600:6.2f} hours')

        sf_tda = None        
        sf_tda = XSF_TDA(mf,method=1,collinear_samples=20)
        e0, values = sf_tda.kernel(nstates=nstates)
        print(f'Multicollinear_{fun} ',mol_i)
        print('excited energy ',e0)
        _ = sf_tda.analyse()
        end_multi = time.time()
        print(f'Time use {(end_multi-end_alda0)/3600:6.2f} hours')
        #sf_tda.calculate_TDM()
        #tda_time = time.time()
        #print(f'Time use for TDM calculation {(tda_time-end_multi)/3600:6.2f} hours')
        mftd2 = sftda.uks_sf.TDDFT_SF(mf)
        mftd2.nstates = nstates # the number of excited states
        mftd2.extype = 1 # 1 for spin flip down excited energies
        mftd2.collinear_samples=20
        mftd2.positive_eig_threshold=-0.1
        mftd2.kernel()
        print(f'{mol_i} USF-TD-DFT')
        mftd2.analyze(verbose=4)

print('Done')
