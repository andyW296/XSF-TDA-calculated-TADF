        atoms = read_xyz(rad[i])
        print(f'molecule_{rad[i]}')
        if '+' in rad[i]:
            charge = 1
        else:
            charge = 0
        mol = gto.M(                 
            atom = atoms,
            #basis = 'aug-cc-pvtz',
            basis='aug-cc-pvtz',
