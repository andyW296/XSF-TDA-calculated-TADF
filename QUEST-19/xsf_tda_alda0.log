        #elif mol.groupname == 'Dooh':
        #    mol.symmetry_subgroup = 'D2h'
        #    mol.build()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
