def read_xyz(name):
    filename = '/export/home/lizd20/zhaohw/tddft/QUESTDB-main/geometries/xyz/'+ name + '.xyz'
    try:
        with open(filename, 'r') as f:
            lines = f.readlines()
    except:
        filename = '/export/home/lizd20/zhaohw/tddft/QUESTDB-main/geometries/xyz/'+ name.lower() + '.xyz'
        with open(filename,'r') as f:
            lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

for fun in funs:
    for i in range(len(rad)):
        atoms = read_xyz(rad[i])
        print(f'molecule_{rad[i]}')
        if '+' in rad[i]:
            charge = 1
        else:
            charge = 0
        mol = gto.M(                 
            atom = atoms,
            #basis = 'aug-cc-pvtz',
            basis='aug-cc-pvtz',
            #basis = 'cc-pvdz',
            #basis='dzp',
            #basis = '6-31G(d)',
            charge = charge,
            spin = 3, 
            verbose = 4,
            #cart=True,
            #symmetry='C2v'
            #symmetry=True,
            )
