def write_h5(name,exciteds,ground,s2,ds2,irreps_g=None):
    fname = name + '.h5'
    f = h5py.File(fname,'w')
    f['molecule'] = name
    #f['grounds'] = np.zeros(len_rad)
    #f['Ds'] = np.zeros((len_rad,nstates))
    f['exciteds'] = exciteds
    f['ground'] = ground
    f['s2'] = s2
    f['ds2'] = ds2
    #f['ground_irrep'] = irreps_g
    f.close()
    return None

#write_h5(fun,nstates,rad)

def read_xyz(name):
    filename = '/export/home/lizd20/zhaohw/tddft/QUESTDB-main/geometries/xyz/'+ name + '.xyz'
    try:
        with open(filename, 'r') as f:
            lines = f.readlines()
    except:
        filename = '/export/home/lizd20/zhaohw/tddft/QUESTDB-main/geometries/xyz/'+ name.lower() + '.xyz'
        with open(filename,'r') as f:
            lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

for fun in funs:
    for i in range(len(rad)):
        atoms = read_xyz(rad[i])
        print(f'molecule_{rad[i]}')
        if '+' in rad[i]:
            charge = 1
        else:
            charge = 0
        mol = gto.M(                 
            atom = atoms,
            #basis = 'aug-cc-pvtz',
            basis='aug-cc-pvtz',
            #basis = 'cc-pvdz',
            #basis='dzp',
            #basis = '6-31G(d)',
            charge = charge,
            spin = 3, 
            verbose = 4,
            #cart=True,
            #symmetry='C2v'
            #symmetry=True,
            )
        #if mol.groupname == 'Coov':
        #    mol.symmetry_subgroup = 'C2v'
        #    mol.build()
        #elif mol.groupname == 'Dooh':
        #    mol.symmetry_subgroup = 'D2h'
        #    mol.build()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
    #mf.irrep_nelec = {'A1':(5,4),'A2':(0,0),'B1':(2,1),'B2':(3,2)}
        mf.level_shift = 0.1
        mf.init_guess = 'huckel'
        mf.grids.atom_grid = (99,590)
        #if rad[i] == 'F2BS':
        #    mf.irrep_nelec = {'A1': (10,10), 'A2':(1,1), 'B1':(4,2),'B2':(6,5)}
    #mf.max_cycle = 100
        #if fun == 'b3lyp':
        #    mf.chkfile = f'test/b3lyp_{rad[i]}.chk'
        #else:
        #data = scf.chkfile.load(f'chkfile/b3lyp_{rad[i]}.chk','scf')
        #mf.mo_coeff = data['mo_coeff']
        #mf.mo_occ = data['mo_occ']
        #mf.mo_energy = data['mo_energy']
        mf.kernel()
        if not mf.converged:
            mf = scf.newton(mf)
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        sf_tda = XSF_TDA(mf,collinear_samples=20)
        e0, values = sf_tda.kernel(nstates=nstates)
        print(f'molecule {rad[i]} {fun}')
        _ = sf_tda.analyse()
        print('ground energy ',mf.e_tot)
        print('excited energy ',e0)
        
        
        #sf_tda = XSF_TDA(mf,method=1,collinear_samples=20)
