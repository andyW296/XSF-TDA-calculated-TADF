#c = lib.param.LIGHT_SPEED
#ha2eV = 27.2113834

#angles = np.arange(0,181,5)
nstates = 5
bas = 'def2-svp'
def read_xyz(name):
   with open(name, 'r') as f:
       lines = f.readlines()
       atoms = []
       for line in lines[2:]:
          parts = line.split()
          if len(parts) >=4:
             atom = parts[0]
             coords = list(map(float, parts[1:4]))
             atoms.append((atom,coords))
   return atoms

path = '/data/zhw/tadf/mewes_35/geometries/'
#funs = ['svwn','blyp','pbe','b3lyp','pbe0','bhandhlyp','hf']
#funs = ['blyp','b3lyp','pbe0','bhandhlyp','camb3lyp']
#mols = ['01/geom.xyz','26/geom.xyz','32/geom.xyz','33/geom.xyz']
mols = [str(i).zfill(2) for i in range(1, 36)]
funs = ['bhandhlyp']
for fun in funs:
    for ind,mol_i in enumerate(mols[15:]):
        mol = gto.M(                 
          atom = path+mol_i+'/geom.xyz',
          basis = bas,
          charge = 0,
          spin = 0, 
          verbose = 4,
          #symmetry=True,
        )    

        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf = scf.sfx2c(mf)
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #if ind != 0:
        #    mf.chkfile = f'chkfile/mol{ind+16}.chk'
        #else:
        data = scf.chkfile.load(f'../chkfile/mol{ind+16}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #if ind == 0:
        stable = True
        #else:
        #    mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
#        print('TDA for singlet and triplet excited energy')
#        mytd = tddft.TDA(mf)
#        mytd.nstates = nstates
#        mytd.singlet = True
#        tda_e,tda_v = mytd.kernel()
#        mytd.analyze()
        
#        mytd = tddft.TDA(mf)
#        mytd.nstates = nstates
#        mytd.singlet = False 
#        tda_e2,tda_v2 = mytd.kernel()
#        mytd.analyze()

        print('TD-DFT for triplet excited energy')
#        mytd = tddft.TDDFT(mf)
#        mytd.nstates = nstates
#        mytd.singlet = True
#        tda_e,tda_v = mytd.kernel()
#        mytd.analyze()

        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        mytd.singlet = False
        tda_e2,tda_v2 = mytd.kernel()
        mytd.analyze()


print('Done')
