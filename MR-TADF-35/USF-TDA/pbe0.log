    for i,mol_i in enumerate(mols):
        atoms = read_xyz(path+mol_i)
        #if len(atoms) > 70 or len(atoms) < 50:
        #    continue    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.4
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.init_guess = 'huckel'
        #mf.chkfile = f'../chk_file/mol{i+1}.chk'
        data = scf.chkfile.load(f'../chk_file/mol{i+1}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')

        sf_tda = SA_SF_TDA(mf,SA=0)
        e0, values = sf_tda.kernel(nstates=nstates,remove=False)
        end_alda0 = time.time()
        print(f'ALDA0_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        print(f'Time use {(end_alda0-end_scf)/3600:6.2f} hours')
        _ = sf_tda.analyse()
        
        sf_tda = SA_SF_TDA(mf,SA=0,method=1,collinear_samples=30)
        e0, values = sf_tda.kernel(nstates=nstates,remove=False)
        end_multi = time.time()
        print(f'Multicollinear_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        print(f'Time use {(end_multi-end_alda0)/3600:6.2f} hours')
        _ = sf_tda.analyse()


print('Done')
