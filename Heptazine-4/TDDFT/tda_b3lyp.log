from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import sys
#sys.path.append('/home/lx/usrs/zhw/software/git_file')
#from SF_XTDA import SA_SF_TDA

#angles = np.arange(0,181,5)
nstates = 7
#funs = ['b3lyp','pbe0','lc_blyp','cam_b3lyp','blyp','pbe','bhandhlyp']
funs = ['b3lyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    filename = '/home/lx/usrs/zhw/tddft/tadf/Miyajima_4/xyz/' +name+'.xyz'
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

mols = ['HzTFEX2','HzPipX2','HzTFEP2','HzTFET2']
for fun in funs:
    for mol_i in mols:
        atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-SVP',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.2
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.max_cycle = 100
        #mf.diis_damp = 0.5
        #mf.chkfile = f'chk_file/{mol_i}.chk'
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            for _ in range(2):
                dm = mf.make_rdm1(mo, mf.mo_occ)
                mf.kernel(dm0=dm)
                mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
                if stable:
                    break
                else:
                    mf.grids.atom_grid = (99,590)
                    mf.level_shift = 0.5
        assert stable
        
        print(f'fun_{fun}')
        print('Singlet')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()

        print('Triplet')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel() 
        mytd2.analyze()

print('Done')
