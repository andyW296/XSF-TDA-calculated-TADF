from pyscf import gto, dft, scf, ao2mo, lib, tddft
from pyscf.fci import addons
import numpy as np
#from pyscf.sftda import tools_td
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import sys
sys.path.append('/data/zhw/software/XTDDFT/')
from xtddft.XSF_TDA import XSF_TDA
#from xtddft.SF_TDA import SF_TDA
#from xtddft.XTDA import X_TDA,XTDA
#from x2c_hamiltonian import sfX2C_soDKH1
#from x2c_hamiltonian.driver.si_driver import SI_driver
#from x2c_hamiltonian.driver.tdm import TDM_S1,TDM_S_1,TDM_S
c = lib.param.LIGHT_SPEED
ha2eV = 27.2113834
eV2cm_1 = 8065.545
hbar = 1.0545718176461565e-34
lib.num_threads(48)

#angles = np.arange(0,181,5)
nstates = 5
#funs = ['b3lyp','pbe0','lc_blyp','cam_b3lyp','blyp','pbe','bhandhlyp']
funs = ['bhandhlyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    filename = '/data/zhw/tadf/Miyajima_4/xyz/' +name+'.xyz'
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

mols = ['HzTFEX2','HzPipX2','HzTFEP2','HzTFET2']
for fun in funs:
    for mol_i in mols:
        atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.2
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.max_cycle = 100
        #mf.diis_damp = 0.5
        #path = '../chk_file/'+str(mol_i)+'.chk'
        #data = scf.chkfile.load(path,'scf')
        #mf.mo_coeff = data['mo_coeff']
        #mf.mo_energy = data['mo_energy']
        #mf.mo_occ = data['mo_occ']
        #mf.chkfile = f'/export/home/lizd20/zhaohw/tddft/tadf/Miyajima_4/usf/svp/chk_file/{mol_i}.chk'
        mf.chkfile = f'chkfile/{mol_i}.chk'
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            for _ in range(2):
                dm = mf.make_rdm1(mo, mf.mo_occ)
                mf.kernel(dm0=dm)
                mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
                if stable:
                    break
                else:
                    mf.grids.atom_grid = (99,590)
                    mf.level_shift = 0.5
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')
        print('TDA')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        tda_e,tda_v = mytd.kernel()
        mytd.analyze()
        print(f'{mol_i} fun_{fun}')
        print(mol_i,' Triplet')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        tda_e2, tda_v2 = mytd2.kernel()
        mytd2.analyze()

        print('TD-DFT')
        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        tda_e,tda_v = mytd.kernel()
        mytd.analyze()
        print(f'{mol_i} fun_{fun}')
        print(mol_i,' Triplet')
        mytd2 = tddft.TDDFT(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        tda_e2, tda_v2 = mytd2.kernel()
        mytd2.analyze()


print('Done')
