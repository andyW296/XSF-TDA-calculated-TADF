from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import pyscf.scf.stability as stab_mod

import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from SF_XTDA import SA_SF_TDA

#angles = np.arange(0,181,5)
nstates = 10
bas = '6-31G*'
funs = ['b3lyp','pbe0','bhandhlyp']

def update_h5(name,count,excited,index_gx):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    f['excited'][count,index_gx] = np.array(excited)
    f.close()
    return None 
def write_h5(name,funs,nstates):
    fname = name + '.h5'
    len_r = len(funs)
    f = h5py.File(fname,'w')
    f['functional'] = funs
    f['excited'] = np.zeros((len_r,6,nstates))
    f.close()
    return None

name = 'mc_gx'
write_h5(name,funs,nstates)
gx = np.arange(6)*0.1

for count,fun in enumerate(funs):    
    mol = gto.M(                 
          atom = '''
 C 0.00000000 -2.29619838  1.32571075
 C 0.00000000 -4.57380843 -2.64068953
 C 0.00000000 -0.00000000 -2.65142150
 C 0.00000000  4.57380843 -2.64068953
 C 0.00000000  2.29619838  1.32571075
 C 0.00000000  0.00000000  5.28137906
 C 0.00000000 -4.57334297 -0.03501138
 C 0.00000000  2.31699223 -3.94312550
 C 0.00000000  2.25635074  3.97813688
 C 0.00000000 -2.25635074  3.97813688
 C 0.00000000 -2.31699223 -3.94312550
 C 0.00000000  4.57334297 -0.03501138
 N 0.00000000 -0.00000000  0.00000000
 H 0.00000000  6.33829394 -3.65941571
 H 0.00000000  0.00000000  7.31883143
 H 0.00000000 -6.33829394 -3.65941571
 H 0.00000000 -6.29930356  1.03947702
 H 0.00000000  2.24943827 -5.97509542
 H 0.00000000  4.04986529  4.93561840
 H 0.00000000 -4.04986529  4.93561840
 H 0.00000000 -2.24943827 -5.97509542
 H 0.00000000  6.29930356  1.03947702
    ''',
      basis = bas,
      charge = 0,
      spin = 2, 
      verbose = 4,
      unit = 'B',
      symmetry=True,
    )    

    if fun == 'hf':
        mf = scf.ROHF(mol)
    else:
        mf = dft.ROKS(mol)
        mf.xc = fun
    mf.grids.atom_grid = (99,590)
    mf = mf.newton()
    mf.kernel()
    assert mf.converged
    mo, _, stable, _ = mf.stability(return_status=True)
    if stable is False:
        dm = mf.make_rdm1(mo, mf.mo_occ)
        mf.kernel(dm0=dm)
        mo, _, stable, _ = mf.stability(return_status=True)
        assert stable
    if fun == 'b3lyp':
        hyb = 0.2
    elif fun == 'pbe0':
        hyb = 0.25
    elif fun == 'bhandhlyp':
        hyb = 0.5
    fglobal = (1-0.3)*hyb+0.3
    for index_gx,gx_i in enumerate(gx):
        sf_tda = SA_SF_TDA(mf,SA=3,method=1)
        fx = fglobal * gx_i
        e0, values = sf_tda.kernel(nstates=nstates,remove=True,fglobal=fx)
        update_h5(name,count,e0,index_gx)
        print(f'fun_{fun} {gx_i:3.2f}')
        _ = sf_tda.analyse()
        print('excited energy ',e0)

print('Done')
