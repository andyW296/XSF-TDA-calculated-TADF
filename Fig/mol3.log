from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import pyscf.scf.stability as stab_mod

import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from SF_XTDA import SA_SF_TDA

#angles = np.arange(0,181,5)
nstates = 10
bas = '6-31G*'
funs = ['b3lyp','pbe0','bhandhlyp']

def update_h5(name,count,excited,index_gx):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    f['excited'][count,index_gx] = np.array(excited)
    f.close()
    return None 
def write_h5(name,funs,nstates):
    fname = name + '.h5'
    len_r = len(funs)
    f = h5py.File(fname,'w')
    f['functional'] = funs
    f['excited'] = np.zeros((len_r,6,nstates))
    f.close()
    return None

name = 'mc_gx'
write_h5(name,funs,nstates)
gx = np.arange(6)*0.1

for count,fun in enumerate(funs):    
    mol = gto.M(                 
          atom = '''
 C 0.00000000 -0.00000000  2.63044602
 C 0.00000000  0.00000000 -5.32562322
 C 0.00000000 -2.28292518 -1.38006964
 C 0.00000000  2.28292518 -1.38006964
 C 0.00000000 -2.25969211 -4.02080437
 C 0.00000000  2.25969211 -4.02080437
 C 0.00000000 -4.51358507  0.05853045
 C 0.00000000  4.51358507  0.05853045
 C 0.00000000 -4.33214653  2.63970976
 C 0.00000000  4.33214653  2.63970976
 N 0.00000000 -0.00000000 -0.07278591
 N 0.00000000 -2.16002933  3.92349961
 N 0.00000000  2.16002933  3.92349961
 H 0.00000000 -4.05303029 -4.97864815
 H 0.00000000  4.05303029 -4.97864815
 H 0.00000000 -6.30224117 -0.90474256
 H 0.00000000  6.30224117 -0.90474256
 H 0.00000000 -6.02602008  3.78110657
 H 0.00000000  6.02602008  3.78110657
 H 0.00000000  0.00000000 -7.36246610
    ''',
      basis = bas,
      charge = 0,
      spin = 2, 
      verbose = 4,
      unit = 'B',
      symmetry=True,
    )    

    if fun == 'hf':
        mf = scf.ROHF(mol)
    else:
        mf = dft.ROKS(mol)
        mf.xc = fun
    #mf.grids.level = 6
    mf.grids.atom_grid = (99,590)
    mf = mf.newton()
    mf.kernel()
    assert mf.converged
    mo, _, stable, _ = mf.stability(return_status=True)
    if stable is False:
        dm = mf.make_rdm1(mo, mf.mo_occ)
        mf.kernel(dm0=dm)
        mo, _, stable, _ = mf.stability(return_status=True)
        assert stable
    if fun == 'b3lyp':
        hyb = 0.2
    elif fun == 'pbe0':
        hyb = 0.25
    elif fun == 'bhandhlyp':
        hyb = 0.5
    fglobal = (1-0.3)*hyb+0.3
    for index_gx,gx_i in enumerate(gx):
        sf_tda = SA_SF_TDA(mf,SA=3,method=1)
        fx = fglobal * gx_i
        e0, values = sf_tda.kernel(nstates=nstates,remove=True,fglobal=fx)
        update_h5(name,count,e0,index_gx)
        print(f'fun_{fun} {gx_i:3.2f}')
        _ = sf_tda.analyse()
        print('excited energy ',e0)

print('Done')
