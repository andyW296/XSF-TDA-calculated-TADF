#INFO: **** input file is /export/home/lizd20/zhaohw/tddft/ten_mols/631G/xsf.py ****
# source /export/home/lizd20/clf/clf_jax/bin/activate

from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py

import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from XSF_TDA import XSF_TDA

#angles = np.arange(0,181,5)
nstates = 7
bas = '6-31G*'
#fun = 'b3lyp'

count = 0
path = '/export/home/lizd20/zhaohw/tddft/ten_mols/xyz/'
#funs = ['svwn','blyp','pbe','b3lyp','pbe0','bhandhlyp','hf']
funs = ['blyp','b3lyp','pbe0','bhandhlyp','camb3lyp']
for fun in funs:
    for mol_i in range(10):
        mol = gto.M(                 
          atom = path+f'mol{mol_i+1}.xyz',
          basis = bas,
          charge = 0,
          spin = 2, 
          verbose = 4,
          unit = 'B',
          #symmetry=True,
        )    

        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.chkfile = f'chkfile/mol{mol_i+1}.chk'
        data = scf.chkfile.load(f'chkfile/mol{mol_i+1}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        #print('alda0')
        #sf_tda = XSF_TDA(mf,SA=3,calculate_sp=True)
        #e0, values = sf_tda.kernel(nstates=nstates)
        #_ = sf_tda.analyse()
        #print(f'ALDA0_{fun} mol_{mol_i+1}')
        #print('excited energy ',e0)
        #sf_tda.calculate_TDM()
        print('multicollinear with scale')
        sf_tda = XSF_TDA(mf,method=1,calculate_sp=True,collinear_samples=20)
        e0, values = sf_tda.kernel(nstates=nstates)
        _ = sf_tda.analyse()
        print(f'Multicollinear_{fun} mol_{mol_i+1}')
        print('excited energy ',e0)
        #sf_tda.calculate_TDM()
        
        print(f'Multicollinear_{fun} mol_{mol_i+1} scale=1')
        sf_tda = XSF_TDA(mf,method=1,collinear_samples=20)
        e0, values = sf_tda.kernel(nstates=nstates,fit=False)
        _ = sf_tda.analyse()
        print('excited energy ',e0)
        #sf_tda.calculate_TDM()


print('Done')
