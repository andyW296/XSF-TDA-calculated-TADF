from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import pyscf.scf.stability as stab_mod

import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from SF_XTDA import SA_SF_TDA

#angles = np.arange(0,181,5)
nstates = 10
bas = '6-31G*'
funs = ['b3lyp','pbe0','bhandhlyp']
#funs = ['bhandhlyp']
def update_h5(name,count,excited,index_gx):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    f['excited'][count,index_gx] = np.array(excited)
    f.close()
    return None 
def write_h5(name,funs,nstates):
    fname = name + '.h5'
    len_r = len(funs)
    f = h5py.File(fname,'w')
    f['functional'] = funs
    f['excited'] = np.zeros((len_r,6,nstates))
    f.close()
    return None

name = 'mc_gx'
write_h5(name,funs,nstates)
gx = np.arange(6)*0.1

for count,fun in enumerate(funs):    
    mol = gto.M(                 
          atom = '''
 B 0.00000000 -0.00000000  0.00000000
 C 0.00000000 -2.41881246  1.39650203
 C 0.00000000 -0.00000000 -2.79300406
 C 0.00000000  2.41881246  1.39650203
 C 0.00000000 -4.60570992 -0.11146995
 C 0.00000000  2.39939076 -3.93292682
 C 0.00000000  2.20631915  4.04439677
 C 0.00000000 -2.20631915  4.04439677
 C 0.00000000 -2.39939076 -3.93292682
 C 0.00000000  4.60570992 -0.11146995
 N 0.00000000 -4.60311804 -2.65761144
 N 0.00000000  4.60311804 -2.65761144
 N 0.00000000  0.00000000  5.31522288
 H 0.00000000 -6.48246078  0.71791171
 H 0.00000000  2.61950061 -5.97293157
 H 0.00000000  3.86296017  5.25501986
 H 0.00000000 -3.86296017  5.25501986
 H 0.00000000 -2.61950061 -5.97293157
 H 0.00000000  6.48246078  0.71791171
''',
      basis = bas,
      charge = 0,
      spin = 2, 
      verbose = 4,
      unit = 'B',
      #symmetry=True,
    )    

    if fun == 'hf':
        mf = scf.ROHF(mol)
    else:
        mf = dft.ROKS(mol)
        mf.xc = fun
    #mf.irrep_nelec= {'A1': (21,20), 'A2':(3,2),'B1':(16,16), 'B2':(4,4)}
    mf.level_shift = 0.2
    #mf.diis_space = 8
    #mf.diis_start_cycle = 5
    #mf.max_cycle = 150
    if fun != 'hf':
        mf.grids.atom_grid = (99,590)
    mf = mf.newton()
    mf.kernel()
    if not mf.converged:
        #if fun == 'hf':
        #    mf = scf.ROHF(mol)
        #else:
        #    mf = dft.ROKS(mol)
        #    mf.xc = fun
        #mf.irrep_nelec= {'A1': (21,20), 'A2':(3,2),'B1':(16,16), 'B2':(4,4)}
        mf.level_shift = 0.55
        mf.diis_space = 8
        mf.diis_damp = 0.5
        mf.diis_start_cycle = 5
        mf = mf.newton()
        mf.max_cycle = 150
        mf.kernel()
    assert mf.converged
    mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
    if stable is False:
        dm = mf.make_rdm1(mo, mf.mo_occ)
        mf.kernel(dm0=dm)
        mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
    
    if fun == 'b3lyp':
        hyb = 0.2
    elif fun == 'pbe0':
        hyb = 0.25
    elif fun == 'bhandhlyp':
        hyb = 0.5
    fglobal = (1-0.3)*hyb+0.3
    for index_gx,gx_i in enumerate(gx):
        sf_tda = SA_SF_TDA(mf,SA=3,method=1)
        fx = fglobal * gx_i
        e0, values = sf_tda.kernel(nstates=nstates,remove=True,fglobal=fx)
        update_h5(name,count,e0,index_gx)
        print(f'fun_{fun} {gx_i:3.2f}')
        _ = sf_tda.analyse()
        print('excited energy ',e0)

print('Done')
