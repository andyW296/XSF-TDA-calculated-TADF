from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import pyscf.scf.stability as stab_mod

import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from SF_XTDA import SA_SF_TDA

#angles = np.arange(0,181,5)
nstates = 10
bas = '6-31G*'
funs = ['svwn','blyp','pbe','b3lyp','pbe0','bhandhlyp','hf']

def update_h5(name,count,excited,index_gx):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    f['excited'][count,index_gx] = np.array(excited)
    f.close()
    return None 
def write_h5(name,funs,nstates):
    fname = name + '.h5'
    len_r = len(funs)
    f = h5py.File(fname,'w')
    f['functional'] = funs
    f['excited'] = np.zeros((len_r,11,nstates))
    f.close()
    return None

name = 'xsf'
write_h5(name,funs,nstates)
gx = np.arange(11)*0.1

for count,fun in enumerate(funs):    
    mol = gto.M(                 
          atom = '''
 B 0.00000000  0.00000000 -0.05273140
 C 0.00000000  0.00000000  2.74223189
 C 0.00000000  0.00000000 -5.33744297
 C 0.00000000  2.45002887 -1.42250939
 C 0.00000000 -2.45002887 -1.42250939
 C 0.00000000  2.38780296  3.90963736
 C 0.00000000 -2.38780296  3.90963736
 C 0.00000000  2.33669736 -4.08087398
 C 0.00000000 -2.33669736 -4.08087398
 C 0.00000000  4.61478223  0.11491651
 C 0.00000000 -4.61478223  0.11491651
 N 0.00000000  4.60210444  2.66349182
 N 0.00000000 -4.60210444  2.66349182
 H 0.00000000  0.00000000 -7.37464827
 H 0.00000000  2.57750127  5.95330533
 H 0.00000000 -2.57750127  5.95330533
 H 0.00000000  6.49745564 -0.70393848
 H 0.00000000 -6.49745564 -0.70393848
 H 0.00000000  4.03886143 -5.22298037
 H 0.00000000 -4.03886143 -5.22298037
''',
      basis = bas,
      charge = 0,
      spin = 2, 
      verbose = 4,
      unit = 'B',
      #symmetry=True,
    )    

    if fun == 'hf':
        mf = scf.ROHF(mol)
    else:
        mf = dft.ROKS(mol)
        mf.xc = fun
    #mf.irrep_nelec={'A1': (21,21),'A2':(3,2), 'B1':(4,3), 'B2':(16,16)}
    mf.level_shift = 0.25
    mf.diis_space = 8
    mf.diis_start_cycle = 5
    mf.max_cycle = 150
    if fun != 'hf':
        mf.grids.atom_grid = (99,590)
    mf = mf.newton()
    mf.kernel()
    assert mf.converged
    #mf.analyze()
    mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
    if stable is False:
        dm = mf.make_rdm1(mo, mf.mo_occ)
        mf.kernel(dm0=dm)
        mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
    
    for index_gx,gx_i in enumerate(gx):
        sf_tda = SA_SF_TDA(mf,SA=3)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True,fglobal=gx_i)
        update_h5(name,count,e0,index_gx)
        print(f'fun_{fun} {gx_i:3.2f}')
        _ = sf_tda.analyse()
        print('excited energy ',e0)


print('Done')
