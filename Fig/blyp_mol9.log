#INFO: **** input file is /data/zhw/tadf/ten_mol/xsf/blyp/blyp.py ****
import os
import sys
from pathlib import Path

# 这些环境变量控制 CPU 并行线程数。
# PySCF、NumPy、MKL/OpenBLAS 都可能开线程；初学时建议先设成一个明确值，
# 否则不同机器上可能因为线程数不同而速度差别很大。
os.environ.setdefault("OMP_NUM_THREADS", "24")
os.environ.setdefault("MKL_NUM_THREADS", "24")
os.environ.setdefault("OPENBLAS_NUM_THREADS", "24")
os.environ.setdefault("NUMEXPR_NUM_THREADS", "24")

import numpy as np
from pyscf import dft, gto, lib, scf
from pyscf.geomopt.berny_solver import optimize

from XTDDFT.utils.backend import backend_info, set_backend
set_backend("cpu")
from XTDDFT.XTDDFT.xsf_tda_down import XSF_TDA_down

lib.num_threads(int(os.environ["OMP_NUM_THREADS"]))
print("backend:", backend_info())

xc = "BLYP"
basis = "6-31G*"
charge = 0
spin = 2
SA = 3
unit = "Angstrom"
cycle = 200
nstates = 7
method = 1  # 1 = multicollinear XSF kernel
collinear_samples = 20

use_density_fit = False
max_memory = 4000
grid_level = 3

gx = np.arange(11)*0.1

for mol_ind in [8]:
        mol_path = '/data/zhw/tadf/ten_mol/xyz/' + f'mol{mol_ind+1}.xyz' 
        mol = gto.M(atom = mol_path, basis = basis, charge = 0,spin = 2,verbose = 4)
        mf = dft.ROKS(mol,xc=xc)
        mf.max_memory = max_memory
        mf.grids.level = grid_level
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf = mf.newton()
            mf.shift_level = 0.4
            mf.max_cycle = 2*cycle
            mf.grids.levle = grid_level + 2
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable        

        for index_gx,gx_i in enumerate(gx):
                xsf = XSF_TDA_down(mf,method=method,SA=SA,davidson=True,
                                   davidson_backend="cpu",collinear_samples=collinear_samples,)
                energies_ev, vectors = xsf.kernel(nstates=nstates,remove=None,
                                                  foo=1.0,
                                                  d_lda=0.3,
                                                  fglobal=0.3*gx_i,
                                                  fit=False,
                                                  save=False)
                print(f'mol{mol_ind}, index_gx {index_gx}, gx_i {gx_i}')
                xsf.analyse()
                xsf = None

print('Done')

