def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    filename = '/export/home/lizd20/zhaohw/tddft/tadf/Miyajima_4/xyz/' +name+'.xyz'
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms

mols = ['HzTFEX2','HzPipX2','HzTFEP2','HzTFET2']
for fun in funs:
    for mol_i in mols:
        atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.2
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.max_cycle = 100
        #mf.diis_damp = 0.5
        #mf.chkfile = f'chk_file/'+mol_i+'.chk'
        data = scf.chkfile.load(f'/export/home/lizd20/zhaohw/tddft/tadf/Miyajima_4/xsf/svp/chk_file/{mol_i}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            for _ in range(2):
                dm = mf.make_rdm1(mo, mf.mo_occ)
                mf.kernel(dm0=dm)
                mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
                if stable:
                    break
                else:
                    mf.grids.atom_grid = (99,590)
                    mf.level_shift = 0.5
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')

        for m in range(2):
            sf_tda = None
            sf_tda = XSF_TDA(mf,SA=3,method=m,calculate_sp=True,collinear_samples=20)
            e0, values = sf_tda.kernel(nstates=nstates,remove=True)
            end = time.time()
            if m == 0:
                print('ALDA0')
            else:
                print('Multicollinear')
            print(f'fun_{fun}')
            print(mol_i)
            print('excited energy ',e0)
            print(f'Time use {(end-end_scf)/3600:6.2f} hours')
            _ = sf_tda.analyse()
            #sf_tda.calculate_TDM()


print('Done')
