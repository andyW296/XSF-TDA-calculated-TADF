        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
            assert stable
        
        print(f'fun_{fun}')
        print(mol_i,' Singlet')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()

