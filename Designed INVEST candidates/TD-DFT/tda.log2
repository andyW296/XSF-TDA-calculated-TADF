        mol = gto.M(                 
              atom = atoms,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 0, 
          verbose = 4,
     #     symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
    #mf.grids.level = 6
