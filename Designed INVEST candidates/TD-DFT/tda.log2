for fun in funs:
    for i,mol_i in enumerate(mols):
        atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 0, 
          verbose = 4,
     #     symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
    #mf.grids.level = 6
    #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
    #mf.level_shift = 0.2
    #mf.grids.atom_grid = (99,590)
    #mf = mf.newton()
    #mf.max_cycle = 100
    #mf.diis_damp = 0.5
    #mf.diis_start_cycle = 3
    #mf.init_guess = 'huckel'
        if fun != 'b3lyp':
            data = scf.chkfile.load(f'chk_file/mol{i+1}.chk','scf')
            mf.mo_coeff = data['mo_coeff']
            mf.mo_occ = data['mo_occ']
            mf.mo_energy = data['mo_energy']
        else:
            mf.chkfile = f'chk_file/mol{i+1}.chk'
        mf.kernel()
    #mf.analyze()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
            assert stable
        
        print(f'fun_{fun}')
        print(mol_i,' Singlet')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()

        print(mol_i,' Triplet')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        mytd2.analyze()

print('Done')
