funs = ['bhandhlyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    filename = '/home/lenovo2/usrs/zhw/TDDFT/SFTDA/TADF/46_IST/46_IST/xyz/'+ name
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms
path = '/export/home/lizd20/zhaohw/tddft/tadf/46_IST/xyz/'
mols = [str(i)+'_optimized.xyz' for i in np.arange(46)+1]
#mols = ['6_optimized.xyz','31_optimized.xyz']
for fun in funs:
    for ind,mol_i in enumerate(mols):
        #atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = path+mol_i,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 2, 
          verbose = 4,
        #  symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf = mol.UKS(xc=fun)
        #mf.max_cycle = 200
        #mf.xc = fun
        #mf.init_guess = 'huckel'
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #mf.kernel()
        #mf = mf.newton()
        #data = scf.chkfile.load('molecule_17_hlx.chk','scf')
        #mf.mo_coeff = data['mo_coeff']
        #mf.mo_energy = data['mo_energy']
        #mf.mo_occ = data['mo_occ']
        mf.chkfile = mf.chkfile = f'chkfile/mol{ind+1}.chk'
        mf.kernel()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #stable = True
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            mf.grids.atom_grid = (99,590)
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
           mf = mf.newton()
           dm = mf.make_rdm1(mo, mf.mo_occ)
           mf.kernel(dm0=dm)
           mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
        mftd2 = sftda.uks_sf.TDDFT_SF(mf)
        mftd2.nstates = nstates # the number of excited states
        mftd2.extype = 1 # 1 for spin flip down excited energies
        mftd2.collinear_samples=30
        mftd2.positive_eig_threshold=-0.1
        mftd2.kernel() 
        print(mol_i)
        mftd2.analyze(verbose=4)
