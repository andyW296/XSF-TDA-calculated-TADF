def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    filename = '/home/lenovo2/usrs/zhw/TDDFT/SFTDA/TADF/46_IST/46_IST/xyz/'+ name
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms
path = '/export/home/lizd20/zhaohw/tddft/tadf/46_IST/xyz/'
mols = [str(i)+'_optimized.xyz' for i in np.arange(46)+1]
#mols = ['6_optimized.xyz','31_optimized.xyz']
for fun in funs:
    for ind,mol_i in enumerate(mols):
        #atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = path+mol_i,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 2, 
          verbose = 4,
        #  symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
