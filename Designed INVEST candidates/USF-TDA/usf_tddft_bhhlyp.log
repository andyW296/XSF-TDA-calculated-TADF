for fun in funs:
    for ind,mol_i in enumerate(mols):
        #atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = path+mol_i,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 2, 
          verbose = 4,
        #  symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
