        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
            assert stable

        sf_tda = SA_SF_TDA(mf,SA=3)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        end = time.time()
        print('ALDA0')
        print(f'fun_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        print(f'Time use {(end-start)/3600:6.2f} hours')
        _ = sf_tda.analyse()

        sf_tda = SA_SF_TDA(mf,SA=3,method=1)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        end = time.time()
        print('Multicollinear')
        print(f'fun_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        print(f'Time use {(end-start)/3600:6.2f} hours')
        _ = sf_tda.analyse()


print('Done')
