    return None

def read_xyz(name):
    filename = '/export/home/lizd20/zhaohw/tddft/tadf/46_IST/xyz/'+ name
    with open(filename, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms
mols = [str(i)+'_optimized.xyz' for i in np.arange(46)+1]
#mols = ['17_optimized.xyz']
for fun in funs:
    for mol_i in mols:
        atoms = read_xyz(mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'aug-cc-pvdz',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.1
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(return_status=True)
            assert stable

        sf_tda = SA_SF_TDA(mf,SA=3)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        end = time.time()
        print(f'fun_{fun}')
        print(mol_i)
        print('excited energy ',e0)
        print(f'Time use {(end-start)/3600:6.2f} hours')
        _ = sf_tda.analyse()


print('Done')
