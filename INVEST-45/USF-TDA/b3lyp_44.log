    mol = gto.M(                 
          atom = atoms,
      basis = 'aug-cc-pvdz',
      charge = 0,
      spin = 2, 
      verbose = 4,
      symmetry=True,
    )    
    start = time.time()
    if fun == 'hf':
        mf = scf.UHF(mol)
    else:
        mf = dft.UKS(mol)
        mf.xc = fun
    #mf.grids.level = 6
    #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
    mf.level_shift = 0.2
    mf.grids.atom_grid = (99,590)
    #mf = mf.newton()
    mf.max_cycle = 100
    mf.diis_damp = 0.5
    mf.diis_start_cycle = 3
    mf.init_guess = 'huckel'
    mf.kernel()
    #mf.analyze()
    #if not mf.converged:
    mf = mf.newton()
    mf.kernel()
    assert mf.converged
    mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
    if stable is False:
        dm = mf.make_rdm1(mo, mf.mo_occ)
        mf.kernel(dm0=dm)
        mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable

    sf_tda = SA_SF_TDA(mf,SA=0)
    e0, values = sf_tda.kernel(nstates=nstates,remove=False)
    end = time.time()
    print(f'ALDA0_{fun}')
    print(mol_i)
    print('excited energy ',e0)
    print(f'Time use {(end-start)/3600:6.2f} hours')
    _ = sf_tda.analyse()

    sf_tda = SA_SF_TDA(mf,SA=0,method=1,collinear_samples=30)
    e0, values = sf_tda.kernel(nstates=nstates,remove=False)
    end = time.time()
    print(f'Multicollinear_{fun}')
    print(mol_i)
    print('excited energy ',e0)
    print(f'Time use {(end-start)/3600:6.2f} hours')
    _ = sf_tda.analyse()

print('Done')
