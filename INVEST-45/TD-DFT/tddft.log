        mf.kernel()
    #mf.analyze()
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
            assert stable
        
        print(f'fun_{fun}')
        print(mol_i,' Singlet')
        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()

        print(mol_i,' Triplet')
        mytd2 = tddft.TDDFT(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        mytd2.analyze()

