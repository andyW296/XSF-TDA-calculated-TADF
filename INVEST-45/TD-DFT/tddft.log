    #mf.diis_start_cycle = 3
    #mf.init_guess = 'huckel'
        #if fun != 'b3lyp':
        data = scf.chkfile.load(f'/export/home/lizd20/zhaohw/tddft/tadf/46_IST/tda/chk_file/mol{i+1}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
