        mytd.kernel()
        mytd.analyze()
        print(f'fun_{fun}')
        print(mol_i,' Triplet')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        mytd2.analyze()

print('Done')
