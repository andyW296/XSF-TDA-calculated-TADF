            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo,mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(tol=1e-7,nroots=5,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'Time use {(end_scf-start)/3600:6.2f} hours')

        print(f'fun_{fun}')
        print(mol_i,' Singlet')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()
        print(f'fun_{fun}')
        print(mol_i,' Triplet')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        mytd2.analyze()

print('Done')
