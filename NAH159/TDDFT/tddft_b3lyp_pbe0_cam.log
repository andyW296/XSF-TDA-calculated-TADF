for fun in funs:
    for i,mol_i in enumerate(mols):
        atoms = read_xyz(path+mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
