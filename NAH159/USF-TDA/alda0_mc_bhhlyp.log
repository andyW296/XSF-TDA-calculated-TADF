folders = glob.glob('/data/zhw/tadf/nah159/geometries/nah159/*')
folders = [f for f in folders if os.path.isdir(f) and os.path.basename(f)[:3].isdigit()]
folders.sort(key=lambda p: int(os.path.basename(p)[:3]))
mols = [i+'/geom.xyz' for i in folders]
#mols = ['17_optimized.xyz']
for fun in funs:
    for ind,mol_i in enumerate(mols):
        atoms = read_xyz(mol_i)
        print('mol_',mol_i)    
        mol = gto.M(                 
              atom = atoms,
          #basis = 'def2-TZVP',
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.UHF(mol)
        else:
            mf = dft.UKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.1
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        #es = []
        #for guess in ['huckel', 'atom','1e','minao']:
        #mf.init_guess = 'huckel'
        #if fun != 'b3lyp':
        data = scf.chkfile.load(f'chkfile/mol{1+ind}.chk','scf')
        mf.mo_coeff = data['mo_coeff']
        mf.mo_occ = data['mo_occ']
        mf.mo_energy = data['mo_energy']
        #else:
        #mf.chkfile = f'chk_file/mol{i+1}.chk'
        #mf.kernel()
        #mf = mf.newton()
        mf.kernel()
        #mf.chkfile = f'chkfile/mol{ind+1}.chk'
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        #stable = True
        mo, _, stable, _ = mf.stability(return_status=True)
        #mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
            #print(f'guess {guess}, total energy {mf.e_tot}')
            #es.append(mf.e_tot)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.level_shift = 0.2
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            mf.grids.atom_grid = (99,590)
            mf.init_guess = 'huckel'
            mf.level_shift = 0.2
            mf = mf.newton()
            mf.kernel()
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
        #print('huckel', 'atom','1e','minao')
        #print(es)
        #if stable is False:
        #    dm = mf.make_rdm1(mo, mf.mo_occ)
        #    mf.level_shift = 0.1
        #    mf.grids.atom_grid = (99,590)
        #    mf = mf.newton()
        #    mf.kernel(dm0=dm)
        #    mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        #if stable is False:
        #    dm = mf.make_rdm1(mo, mf.mo_occ)
        #    mf.level_shift = 0.5
        #    mf.kernel(dm0=dm)
        #    mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        #assert stable
        sf_tda = XSF_TDA(mf,method=0)
        e0, values = sf_tda.kernel(nstates=nstates)
        print(f'{mol_i} ALDA0_{fun}')
        _ = sf_tda.analyse()

        sf_tda = XSF_TDA(mf,method=1,collinear_samples=20)
        e0, values = sf_tda.kernel(nstates=nstates)
        end = time.time()
        print(f'{mol_i} Multicoll_{fun}')
        _ = sf_tda.analyse()

        mftd2 = sftda.uks_sf.TDDFT_SF(mf)
        mftd2.nstates = nstates # the number of excited states
        mftd2.extype = 1 # 1 for spin flip down excited energies
        mftd2.collinear_samples=20
        mftd2.positive_eig_threshold=-0.1
        mftd2.kernel()
        print(f'{mol_i} USF-TD-DFT')
        mftd2.analyze(verbose=4)

print('Done')
