#INFO: **** input file is /home/lx/usrs/zhw/tddft/tadf/nah159/tda/tda_nah.py ****
# source /export/home/lizd20/clf/clf_jax/bin/activate

from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import os
import glob
import sys
#sys.path.append('/home/lx/usrs/zhw/software/git_file')
#from SF_XTDA import SA_SF_TDA

#lib.num_threads(48)
#angles = np.arange(0,181,5)
nstates = 5
#funs = ['blyp','pbe','b3lyp','pbe0','bhandhlyp','lc_blyp','cam_b3lyp']
funs = ['bhandhlyp']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    #filename =
    with open(name, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms


path = '/home/lx/usrs/zhw/tddft/tadf/nah159/geometries/nah159/'
files = [os.path.basename(p) for p in glob.glob(os.path.join(path, "*")) if os.path.isdir(p)]
mols = [i+'/geom.xyz' for i in files]
#mols = ['17_optimized.xyz']
for fun in funs:
   for i,mol_i in enumerate(mols[116:]):
        atoms = read_xyz(path+mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 0, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.RHF(mol)
        else:
            mf = dft.RKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        #mf.level_shift = 0.1
        #mf.grids.atom_grid = (99,590)
        #mf = mf.newton()
        mf.chkfile = f'chkfile/mol{i+117}.chk'
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.level_shift = 0.1
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'SCF time {(end_scf-start)/3600:6.2f} hours')

        print(f'{mol_i} Singlet TDA fun_{fun}')
        mytd = tddft.TDA(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()
        print(f'{mol_i} Triplet TDA fun_{fun}')
        mytd2 = tddft.TDA(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()
        mytd2.analyze()
        
        print(f'{mol_i} Singlet TDDFT fun_{fun}')
        mytd = tddft.TDDFT(mf)
        mytd.nstates = nstates
        mytd.kernel()
        mytd.analyze()
        print(f'{mol_i} Triplet TDDFTT fun_{fun}')
        mytd2 = tddft.TDDFT(mf)
        mytd2.nstates = nstates
        mytd2.singlet = False
        mytd2.kernel()

print('Done')
