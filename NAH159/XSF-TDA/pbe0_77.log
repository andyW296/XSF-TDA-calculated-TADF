from pyscf import gto, dft, scf, ao2mo, lib, tddft,fci
from pyscf.fci import addons
import numpy as np
from pyscf.dft import numint
import scipy
from functools import reduce
import h5py
import time
import os
import glob
import sys
sys.path.append('/export/home/lizd20/zhaohw/tddft/')
from XSF_TDA import XSF_TDA

lib.num_threads(48)
#angles = np.arange(0,181,5)
nstates = 7
#funs = ['blyp','pbe','b3lyp','pbe0','bhandhlyp','lc_blyp','cam_b3lyp']
funs = ['pbe0']
def update_h5(name,sa,count,excited,vect,ground=None,ds=None):
    fname = name + '.h5'
    f = h5py.File(fname,'a')
    if ground is not None:
        f['grounds'][count] = ground
        f['Ds'][count] = ds
    f['vects'][sa,count] = np.array(vect)
    f['exciteds'][sa,count] = np.array(excited)
    f.close()
    return None 
def write_h5(R,nstates,name):
    fname = name + '.h5'
    len_r = len(R)
    f = h5py.File(fname,'w')
    f['R'] = R
    f['grounds'] = np.zeros(len_r)
    f['vects'] = np.zeros((5,len_r,nstates,5))
    f['exciteds'] = np.zeros((5,len_r,nstates))
    f['Ds'] = np.zeros((len_r,nstates))
    f.close()
    return None

def read_xyz(name):
    #filename =
    with open(name, 'r') as f:
        lines = f.readlines()
    atoms = []
    for line in lines[2:]:
        parts = line.split()
        if len(parts) >=4:
            atom = parts[0]
            coords = list(map(float, parts[1:4]))
            atoms.append((atom,coords))
    return atoms


path = '/export/home/lizd20/zhaohw/tddft/tadf/nah159/geometries/nah159/'
files = [os.path.basename(p) for p in glob.glob(os.path.join(path, "*")) if os.path.isdir(p)]
mols = [i+'/geom.xyz' for i in files]
#mols = ['17_optimized.xyz']
for fun in funs:
    for i,mol_i in enumerate(mols[76:77]):
        atoms = read_xyz(path+mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
        #mf.grids.level = 6
        #mf.irrep_nelec = {'A1': (4,2), 'B1':(1,1), 'B2':(1,1)}
        mf.level_shift = 0.1
        mf.grids.atom_grid = (99,590)
        mf.init_guess = 'huckel'
        #mf = mf.newton()
        #try:
        #    data = scf.chkfile.load(f'../chk_file/mol{i+1}.chk','scf')
        #    mf.mo_coeff = data['mo_coeff']
        #    mf.mo_occ = data['mo_occ']
        #    mf.mo_energy = data['mo_energy']
        #except:
        #    print('Can not find chkfile')
        #    mf.chkfile = f'../chkfile/mol{i+1}.chk'
        #mf.chkfile = f'chk_file/mol{i+1}.chk'
        mf.kernel()
    
        if not mf.converged:
            mf = mf.newton()
            mf.kernel()
        assert mf.converged
        mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.level_shift = 0.1
            mf.grids.atom_grid = (99,590)
            mf = mf.newton()
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        if stable is False:
            dm = mf.make_rdm1(mo, mf.mo_occ)
            mf.level_shift = 0.5
            mf.kernel(dm0=dm)
            mo, _, stable, _ = mf.stability(nroots=5,tol=1e-7,return_status=True)
        assert stable
        end_scf = time.time()
        print(f'SCF time {(end_scf-start)/3600:6.2f} hours')

        print(f'ALDA0_{fun} {mol_i} ')
        sf_tda = XSF_TDA(mf,SA=3,calculate_sp=True)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        end_alda0 = time.time()
        print(f'ALDA0_{fun} {mol_i}')
        print('excited energy ',e0)
        print(f'Time use {(end_alda0-end_scf)/3600:6.2f} hours')
        _ = sf_tda.analyse()
        #sf_tda.calculate_TDM()
        
        print(f'Multicollinear_{fun} {mol_i}')
        sf_tda = XSF_TDA(mf,SA=3,method=1,collinear_samples=20,calculate_sp=True)
        e0, values = sf_tda.kernel(nstates=nstates,remove=True)
        end_multi = time.time()
        print(f'Multicollinear_{fun} {mol_i}')
        print('excited energy ',e0)
        print(f'Time use {(end_multi-end_alda0)/3600:6.2f} hours')
        _ = sf_tda.analyse()
        #sf_tda.calculate_TDM()


print('Done')
