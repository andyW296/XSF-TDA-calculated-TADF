        atoms = read_xyz(path+mol_i)    
        mol = gto.M(                 
              atom = atoms,
          basis = 'def2-svp',
          charge = 0,
          spin = 2, 
          verbose = 4,
         # symmetry=True,
        )    
        start = time.time()
        if fun == 'hf':
            mf = scf.ROHF(mol)
        else:
            mf = dft.ROKS(mol)
            mf.xc = fun
